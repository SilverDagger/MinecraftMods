{
  "schema_version": 3,
  "profiles": {
    "*": {
      "jitter": {
        "enabled": true
      },
      "upscale": {
        "enabled": true,
        "internal_format": "rgba16f",
        "hdr": true,
        "auto_exposure": true,
        "motion_jittered": false,
        "supports_frame_generation_only": true,
        "trigger": {
          "type": "BEFORE",
          "pass": "composite14"
        },
        "inputs": {
          "color": {
            "enabled": true,
            "src": "autotex5",
            "region": [0, 0, -1, -1]
          },
          "depth": {
            "enabled": true,
            "src": "autotex15",
            "region": [0, 0, -1, -1]
          },
          "motion_vectors": {
            "enabled": true,
            "src": "autotex13",
            "region": [0, 0, -1, -1]
          }
        },
        "outputs": {
          "upscaled_color": {
            "enabled": true,
            "target": ["autotex5"],
            "region": [0, 0, -2, -2]
          }
        }
      }
    }
  }
}
